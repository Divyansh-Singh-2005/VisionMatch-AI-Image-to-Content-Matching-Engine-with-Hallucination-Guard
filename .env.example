# Gemini (Google AI Studio key, free tier, no card)
GEMINI_API_KEY=your-gemini-api-key-here
VISION_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Pexels (free API key, no card) - only used by scripts/fetch_corpus.py
PEXELS_API_KEY=your-pexels-api-key-here

# Database (host port 5434 to avoid clashing with any local Postgres)
DATABASE_URL=postgresql+psycopg://imgmatch:imgmatch@localhost:5434/imgmatch
POSTGRES_USER=imgmatch
POSTGRES_PASSWORD=imgmatch
POSTGRES_DB=imgmatch

# Matching / guard (tuned later from the eval set)
SIMILARITY_THRESHOLD=0.70
MIN_VISION_CONFIDENCE=0.60

# Cost / budget guard (free tier: real cost is $0, so budget on calls)
DAILY_CALL_BUDGET=500
VISION_RPM_LIMIT=8
EMBED_RPM_LIMIT=60
TOP_K=5
UNVERIFIED_SUBJECT_THRESHOLD=0.80
